@tailwind base;
@tailwind components;
@tailwind utilities;

@font-face {
    font-family: 'Cairo';
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

:root {
    --brand-color: #0E90D9;
}

:root,
body {
    font-family: 'Cairo', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
}

@layer components {
    .primary-button {
        @apply bg-[var(--brand-color)] border border-[var(--brand-color)] text-white cursor-pointer inline-flex items-center justify-center font-semibold px-4 py-2 rounded-lg transition-all hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[var(--brand-color)] focus:ring-offset-2;
    }

    .secondary-button {
        @apply border-2 border-[var(--brand-color)] bg-transparent text-[var(--brand-color)] cursor-pointer inline-flex items-center justify-center font-semibold px-4 py-2 rounded-lg transition-all hover:bg-[var(--brand-color)]/10 focus:outline-none focus:ring-2 focus:ring-[var(--brand-color)] focus:ring-offset-2 dark:text-white dark:border-white;
    }

    .transparent-button {
        @apply inline-flex cursor-pointer items-center justify-center rounded-lg border-2 border-transparent px-3 py-1.5 font-semibold text-gray-600 transition-all hover:bg-gray-100 focus:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800 dark:focus:bg-gray-800;
    }
}
