                @if (config('{{ PACKAGE_KEY }}_web.branding.logo'))
                    <img src="{{ config('{{ PACKAGE_KEY }}_web.branding.logo') }}" alt="{{ config('{{ PACKAGE_KEY }}_web.branding.name', '{{ PACKAGE_TITLE }}') }}" class="h-8 w-auto">
                @else
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--brand-color)] font-extrabold text-white">
