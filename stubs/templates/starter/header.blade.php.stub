    </div>

    <!-- Mobile Responsive Menu Drawer -->
    <div
        id="mobile-menu"
        class="hidden md:hidden border-t border-gray-200 bg-white px-4 pt-2 pb-4 dark:border-gray-800 dark:bg-gray-900 transition-all"
        aria-hidden="true"
    >
        @php
            $mobileNavItems = collect(config('{{ PACKAGE_KEY }}_web.navigation', []))
                ->sortBy('sort', SORT_NUMERIC)
                ->all();
        @endphp

        <div class="flex flex-col space-y-3 pt-2">
            @foreach ($mobileNavItems as $item)
                @php
                    $routeName = $item['route'] ?? null;
                    $params = $item['params'] ?? [];
                    $url = $routeName && \Illuminate\Support\Facades\Route::has($routeName)
                        ? route($routeName, $params)
                        : ($item['url'] ?? '#');

                    $isActive = false;
                    if ($routeName && request()->routeIs($routeName)) {
                        if (empty($params) || (! empty($params['page']) && request()->route('page') === $params['page'])) {
                            $isActive = true;
                        }
                    }
                @endphp

                <a
                    href="{{ $url }}"
                    class="text-base text-decoration-none transition-colors {{ $isActive ? 'font-bold text-[var(--brand-color)]' : 'font-medium text-gray-700 hover:text-[var(--brand-color)] dark:text-gray-200' }}"
                >
                    {{ trans($item['name'] ?? '') }}
                </a>
            @endforeach

            @if ($authEnabled)
                <div class="border-t border-gray-200 dark:border-gray-800 pt-3">
                    @if ($isAuth)
                        <div class="mb-2 text-xs font-semibold text-gray-500 dark:text-gray-400">
                            {{ $user->name ?? $user->email ?? 'Account' }}
                        </div>
                        <a href="{{ route('{{ PACKAGE_KEY }}.web.account.dashboard') }}" class="block text-base font-medium text-gray-700 hover:text-[var(--brand-color)] dark:text-gray-200 text-decoration-none mb-2">
                            @lang('{{ PACKAGE_KEY }}_web::app.web.auth.dashboard')
                        </a>
                        @if (! empty($authConfig['routes']['logout']) && \Illuminate\Support\Facades\Route::has($authConfig['routes']['logout']))
                            <form method="POST" action="{{ route($authConfig['routes']['logout']) }}" class="m-0">
                                @csrf
                                <button type="submit" class="text-base font-medium text-red-600 dark:text-red-400 bg-transparent border-0 p-0 cursor-pointer">
                                    @lang('{{ PACKAGE_KEY }}_web::app.web.auth.logout')
                                </button>
                            </form>
                        @endif
                    @else
                        @if (! empty($authConfig['routes']['login']) && \Illuminate\Support\Facades\Route::has($authConfig['routes']['login']))
                            <a href="{{ route($authConfig['routes']['login']) }}" class="inline-block rounded-lg bg-[var(--brand-color)] px-4 py-2 text-sm font-bold text-white hover:opacity-90 text-decoration-none text-center">
                                @lang('{{ PACKAGE_KEY }}_web::app.web.auth.login')
                            </a>
                        @endif
                    @endif
                </div>
            @endif
        </div>
    </div>
</header>
