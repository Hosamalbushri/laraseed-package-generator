                    </span>
                @endif
                <span>{{ config('{{ PACKAGE_KEY }}_web.branding.name') ? trans(config('{{ PACKAGE_KEY }}_web.branding.name')) : trans('{{ PACKAGE_KEY }}_web::app.web.title') }}</span>
            </a>
        </div>

        <!-- Desktop Navigation Bar -->
        <x-{{ PACKAGE_KEY }}_web::layouts.header.navbar />

        <!-- Actions: Auth, Theme Toggle, Locale Switch & Mobile Toggle -->
        <div class="flex items-center gap-2 sm:gap-3">
            @php
                $authConfig = config('{{ PACKAGE_KEY }}_web.auth', []);
                $authEnabled = (bool) ($authConfig['enabled'] ?? false);
                $guard = $authConfig['guard'] ?? null;
                $isAuth = $authEnabled && $guard && auth()->guard($guard)->check();
                $user = $isAuth ? auth()->guard($guard)->user() : null;
            @endphp

            @if ($authEnabled)
                @if ($isAuth)
                    <div class="hidden sm:flex items-center gap-3">
                        <a
                            href="{{ route('{{ PACKAGE_KEY }}.web.account.dashboard') }}"
                            class="text-sm font-medium text-gray-700 hover:text-[var(--brand-color)] dark:text-gray-300 dark:hover:text-white text-decoration-none"
                        >
                            @lang('{{ PACKAGE_KEY }}_web::app.web.auth.dashboard')
                        </a>

                        @if (! empty($authConfig['routes']['logout']) && \Illuminate\Support\Facades\Route::has($authConfig['routes']['logout']))
                            <form method="POST" action="{{ route($authConfig['routes']['logout']) }}" class="inline m-0">
                                @csrf
                                <button
                                    type="submit"
                                    class="rounded-lg px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800 border border-gray-200 dark:border-gray-700 cursor-pointer bg-transparent transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--brand-color)]"
                                >
                                    @lang('{{ PACKAGE_KEY }}_web::app.web.auth.logout')
                                </button>
                            </form>
                        @endif
                    </div>
                @else
                    @if (! empty($authConfig['routes']['login']) && \Illuminate\Support\Facades\Route::has($authConfig['routes']['login']))
                        <a
                            href="{{ route($authConfig['routes']['login']) }}"
                            class="hidden sm:inline-flex rounded-lg bg-[var(--brand-color)] px-3 py-1.5 text-xs font-bold text-white hover:opacity-90 text-decoration-none transition-opacity focus:outline-none focus:ring-2 focus:ring-[var(--brand-color)] focus:ring-offset-2"
                        >
                            @lang('{{ PACKAGE_KEY }}_web::app.web.auth.login')
                        </a>
                    @endif
                @endif
            @endif

            <!-- Dark Mode Toggle -->
            <button
                type="button"
                id="theme-toggle"
                data-action="toggle-dark-mode"
                class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 cursor-pointer border-0 bg-transparent focus:outline-none focus:ring-2 focus:ring-[var(--brand-color)]"
                aria-label="Toggle Dark Mode"
            >
                <svg class="h-5 w-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
