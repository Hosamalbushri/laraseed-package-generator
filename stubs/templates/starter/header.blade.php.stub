            </button>

            <!-- Language Switcher -->
            <a
                href="?locale={{ app()->getLocale() === 'ar' ? 'en' : 'ar' }}"
                class="rounded-lg px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800 border border-gray-200 dark:border-gray-700 text-decoration-none transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--brand-color)]"
                title="Switch Language"
            >
                {{ app()->getLocale() === 'ar' ? 'EN' : 'العربية' }}
            </a>

            <!-- Mobile Menu Toggle Button -->
            <button
                type="button"
                id="mobile-menu-button"
                data-action="toggle-mobile-menu"
                class="md:hidden rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 cursor-pointer border-0 bg-transparent focus:outline-none focus:ring-2 focus:ring-[var(--brand-color)]"
                aria-controls="mobile-menu"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
